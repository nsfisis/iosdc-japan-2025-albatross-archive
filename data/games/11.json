:#D73A49\">func</span><span style=\"color:#6F42C1\"> formatBytes</span><span style=\"color:#24292E\">(</span><span style=\"color:#6F42C1\">_</span><span style=\"color:#24292E\"> bytes: </span><span style=\"color:#005CC5\">Int</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">-></span><span style=\"color:#005CC5\"> String</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    let</span><span style=\"color:#24292E\"> unit </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> units.</span><span style=\"color:#005CC5\">first</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">where</span><span style=\"color:#24292E\">: { bytes </span><span style=\"color:#D73A49\">>=</span><span style=\"color:#005CC5\"> $0</span><span style=\"color:#24292E\">.threshold })</span><span style=\"color:#D73A49\">!</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    let</span><span style=\"color:#24292E\"> value </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> bytes </span><span style=\"color:#D73A49\">/</span><span style=\"color:#24292E\"> unit.threshold</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    let</span><span style=\"color:#24292E\"> significantDigit </span><span style=\"color:#D73A49\">=</span><span style=\"color:#005CC5\"> extractMostSignificantDigit</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">from</span><span style=\"color:#24292E\">: value)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    return</span><span style=\"color:#032F62\"> \"</span><span style=\"color:#032F62\">\\(significantDigit)</span><span style=\"color:#032F62\"> \\(unit.</span><span style=\"color:#24292E\">name</span><span style=\"color:#032F62\">)</span><span style=\"color:#032F62\">\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">func</span><span style=\"color:#6F42C1\"> extractMostSignificantDigit</span><span style=\"color:#24292E\">(</span><span style=\"color:#6F42C1\">from</span><span style=\"color:#24292E\"> number: </span><span style=\"color:#005CC5\">Int</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">-></span><span style=\"color:#005CC5\"> Int</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    var</span><span style=\"color:#24292E\"> highestPowerOfTen </span><span style=\"color:#D73A49\">=</span><span style=\"color:#005CC5\"> 1</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    var</span><span style=\"color:#24292E\"> temporary </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> number</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    while</span><span style=\"color:#24292E\"> temporary </span><span style=\"color:#D73A49\">>=</span><span style=\"color:#005CC5\"> 10</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        temporary </span><span style=\"color:#D73A49\">/=</span><span style=\"color:#005CC5\"> 10</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        highestPowerOfTen </span><span style=\"color:#D73A49\">*=</span><span style=\"color:#005CC5\"> 10</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    return</span><span style=\"color:#24292E\"> temporary </span><span style=\"color:#D73A49\">*</span><span style=\"color:#24292E\"> highestPowerOfTen</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">while</span><span style=\"color:#D73A49\"> let</span><span style=\"color:#24292E\"> line </span><span style=\"color:#D73A49\">=</span><span style=\"color:#005CC5\"> readLine</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    if</span><span style=\"color:#D73A49\"> let</span><span style=\"color:#24292E\"> bytes </span><span style=\"color:#D73A49\">=</span><span style=\"color:#005CC5\"> Int</span><span style=\"color:#24292E\">(line) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5\">        print</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">formatBytes</span><span style=\"color:#24292E\">(bytes))</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span></code></pre>"},"started_at":1758274860}}
